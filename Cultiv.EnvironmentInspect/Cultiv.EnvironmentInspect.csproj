<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
	  <Product>Cultiv.EnvironmentInspect</Product>
	  <PackageId>Cultiv.EnvironmentInspect</PackageId>
	  <Title>Cultiv Environment Variables Inspector</Title>
	  <Description>This installs a dashboard in the Settings section of Umbraco, showing you the currently applied environment values and where they are coming from.</Description>
	  <PackageTags>umbraco plugin package umbraco-marketplace</PackageTags>
	  <RootNamespace>Cultiv.EnvironmentInspect</RootNamespace>
	  <Authors>Sebastiaan Janssen, Jeavon Leopold, Matthew Hart</Authors>
	  <PackageProjectUrl>https://github.com/nul800sebastiaan/Cultiv.EnvironmentInspect</PackageProjectUrl>
	  <PackageLicenseFile>LICENSE</PackageLicenseFile>
	  <PackageIcon>logo.png</PackageIcon>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageVersion>$(PackageVersion)</PackageVersion>
	  <Version>$(PackageVersion)</Version>
    <FileVersion>$(FileVersionNumber)</FileVersion>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="17.0.0-rc4" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="17.0.0-rc4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dont include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
	  <None Include="../LICENSE" Pack="true" PackagePath="" />
	  <None Include="../README.md" Pack="true" PackagePath="" />
	  <None Include="../logo.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
